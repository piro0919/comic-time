# Copy to .env.local and fill in. Never commit real values.
# Checked by src/lib/serverEnv.ts when login or follows are first used.

# Postgres (Neon) for users, sessions, follows, opened episodes, early-access sites
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
# Optional. The site's own origin; inferred from the request when unset
BETTER_AUTH_URL=

# Google OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. /ranking renders empty without it
VERCEL_ANALYTICS_TOKEN=

# Optional. Shared secret for /api/relay, which the scrape workflow uses to read
# sites that refuse connections from outside Japan. Set the same value in the
# GitHub secret of the same name. Without it, /api/relay answers 404
SCRAPE_RELAY_TOKEN=
