    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "5.7.0",
    "react-ios-pwa-prompt": "2.0.6",
    "ress": "5.0.2",
    "sonner": "2.0.8",
    "use-pwa": "2.2.0",
    "use-show-window-size": "0.0.1",
    "usehooks-ts": "3.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@piro0919/eslint-config": "github:piro0919/eslint-config#v1.1.0",
    "@playwright/test": "1.64.0",
    "@secretlint/secretlint-rule-preset-recommend": "11.7.1",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "8.71.1",
    "@uphold/commitlint-config": "1.1.1",
    "cheerio": "1.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-css": "0.12.0",
    "eslint-plugin-css-modules": "2.12.0",
    "eslint-plugin-ext": "0.1.0",
    "eslint-plugin-filenames": "1.3.2",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-perfectionist": "4.15.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-security": "3.0.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-write-good-comments": "0.2.0",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "next-sitemap": "4.2.3",
    "prettier": "3.9.10",
    "secretlint": "11.7.1",
    "sharp": "0.35.5",
    "squawk-cli": "2.68.0",
    "stylelint": "16.26.1",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-recommended": "16.0.0",
    "stylelint-css-modules-no-global-scoped-selector": "1.0.2",
    "stylelint-declaration-block-no-ignored-properties": "2.8.0",
    "stylelint-high-performance-animation": "1.11.0",
    "stylelint-no-unused-selectors": "1.0.40",
    "stylelint-order": "7.0.1",
    "typescript": "^7.0.2"
  },
  "name": "comic-time",
  "overrides": {
    "stylelint-css-modules-no-global-scoped-selector": {
      "stylelint": "$stylelint"
    },
    "stylelint-no-unused-selectors": {
      "stylelint": "$stylelint"
    }
  },
  "private": true,
  "scripts": {
    "analytics": "node scripts/analytics/index.ts",
    "build": "next build",
    "catalog": "node scripts/catalog/index.ts",
    "dev": "next dev --turbopack",
    "lefthook": "npx lefthook run pre-commit",
    "lighthouse": "rm -rf .lighthouseci && npm run build && lhci autorun",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:secret": "npx secretlint --maskSecrets '**/*'",
    "lint:style": "stylelint --fix '**/*.css'",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate/index.ts",
    "migrate:check": "node --env-file-if-exists=.env.local scripts/migrate/index.ts --check",
    "postbuild": "next-sitemap",
    "prettier": "prettier --write .",
    "scrape": "node scripts/scrape/index.ts",
    "scrape:site-icons": "node scripts/siteIcons/index.ts",
    "scrape:site-images": "node scripts/siteImages/index.ts",
    "scrape:work-thumbs": "node scripts/workThumbs/index.ts",
    "secretlint": "secretlint '**/*'",
    "start": "next start",
    "test": "node --import ./tests/register.ts --test 'tests/**/*.test.ts'",
    "test:e2e": "playwright test",
    "type-check": "tsc --noemit",
    "knip": "knip"
  },
  "version": "0.1.0"
}
